## Producción en VPS: copiar a deploy/.env en el servidor y completar. Nunca versionar deploy/.env.

# Dominio público del panel; la API queda en https://<APP_DOMAIN>/api/v1.
APP_DOMAIN="gestion.academiacarmesi.com.ar"

# Neon: DATABASE_URL usa el host con "-pooler" (la API); DIRECT_URL el host directo (migraciones).
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

AUTH_SESSION_HOURS="12"
BUSINESS_TIMEZONE="America/Buenos_Aires"

# Respaldo diario (deploy/backup-db.sh): carpeta del VPS y días que se conservan.
BACKUP_DIR="/var/backups/academy"
BACKUP_RETENTION_DAYS="30"
