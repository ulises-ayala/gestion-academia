generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AdminRole {
  ADMINISTRATOR
  RECEPTION
  MANAGER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum MonthlyChargeStatus {
  PENDING
  PAID
  VOID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model Student {
  id             String          @id @default(uuid()) @db.Uuid
  dni            String          @unique @db.VarChar(32)
  firstName      String          @map("first_name") @db.VarChar(100)
  lastName       String          @map("last_name") @db.VarChar(100)
  birthDate      DateTime?       @map("birth_date") @db.Date
  phone          String?         @db.VarChar(50)
  email          String?         @db.VarChar(254)
  address        String?
  joinedAt       DateTime        @default(now()) @map("joined_at") @db.Date
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollments    Enrollment[]
  monthlyCharges MonthlyCharge[]

  @@index([lastName, firstName])
  @@map("students")
}

model Teacher {
  id        String         @id @default(uuid()) @db.Uuid
  dni       String         @unique @db.VarChar(32)
  firstName String         @map("first_name") @db.VarChar(100)
  lastName  String         @map("last_name") @db.VarChar(100)
  phone     String?        @db.VarChar(50)
  email     String?        @db.VarChar(254)
  address   String?
  status    RecordStatus   @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes   AcademyClass[]

  @@index([lastName, firstName])
  @@map("teachers")
}

model DanceType {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(100)
  normalizedName String         @unique @map("normalized_name") @db.VarChar(100)
  description    String?
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes        AcademyClass[]

  @@index([name])
  @@map("dance_types")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(120)
  address   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  rooms     Room[]

  @@index([name])
  @@map("branches")
}

model Room {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(120)
  capacity  Int
  branchId  String          @map("branch_id") @db.Uuid
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch          @relation(fields: [branchId], references: [id])
  schedules ClassSchedule[]

  @@index([branchId, status])
  @@index([name])
  @@map("rooms")
}

model AcademyClass {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(150)
  danceTypeId String          @map("dance_type_id") @db.Uuid
  teacherId   String          @map("teacher_id") @db.Uuid
  level       String?         @db.VarChar(100)
  capacity    Int
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  danceType   DanceType       @relation(fields: [danceTypeId], references: [id])
  teacher     Teacher         @relation(fields: [teacherId], references: [id])
  schedules   ClassSchedule[]
  enrollments Enrollment[]

  @@index([danceTypeId, status])
  @@index([teacherId, status])
  @@index([name])
  @@map("classes")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class          AcademyClass     @relation(fields: [classId], references: [id], onDelete: Restrict)
  monthlyCharges MonthlyCharge[]
  attendances    StudentAttendance[]

  @@index([studentId, status])
  @@index([classId, status])
  @@map("enrollments")
}

model Tariff {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  amount         Decimal         @db.Decimal(12, 2)
  validFrom      DateTime        @map("valid_from") @db.Date
  validTo        DateTime?       @map("valid_to") @db.Date
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  monthlyCharges MonthlyCharge[]

  @@index([status, validFrom, validTo])
  @@index([name])
  @@map("tariffs")
}

model MonthlyCharge {
  id             String              @id @default(uuid()) @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  enrollmentId   String              @map("enrollment_id") @db.Uuid
  tariffId       String              @map("tariff_id") @db.Uuid
  period         DateTime            @db.Date
  baseAmount     Decimal             @map("base_amount") @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal             @map("final_amount") @db.Decimal(12, 2)
  dueDate        DateTime            @map("due_date") @db.Date
  status         MonthlyChargeStatus @default(PENDING)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment     Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  tariff         Tariff              @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, period])
  @@index([studentId, period, status])
  @@index([enrollmentId, period, status])
  @@index([period, status])
  @@index([tariffId])
  @@map("monthly_charges")
}

model ClassSchedule {
  id        String       @id @default(uuid()) @db.Uuid
  classId   String       @map("class_id") @db.Uuid
  dayOfWeek DayOfWeek    @map("day_of_week")
  startTime DateTime     @map("start_time") @db.Time(0)
  endTime   DateTime     @map("end_time") @db.Time(0)
  roomId    String       @map("room_id") @db.Uuid
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  class     AcademyClass @relation(fields: [classId], references: [id])
  room      Room         @relation(fields: [roomId], references: [id])

  @@index([classId, status])
  @@index([roomId, dayOfWeek, status, startTime, endTime])
  @@map("class_schedules")
}

model StudentAttendance {
  id             String           @id @default(uuid()) @db.Uuid
  enrollmentId   String           @map("enrollment_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, attendanceDate])
  @@index([attendanceDate])
  @@map("student_attendances")
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique @db.VarChar(100)
  passwordHash String         @map("password_hash")
  role         AdminRole      @default(RECEPTION)
  status       RecordStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
