generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AdminRole {
  ADMINISTRATOR
  RECEPTION
  MANAGER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum MonthlyChargeStatus {
  PENDING
  PARTIAL
  PAID
  VOID
}

/// MONTHLY = cuota de un mes con su tarifa. HISTORICAL_DEBT = deuda anterior cargada como monto único.
enum MonthlyChargeKind {
  MONTHLY
  HISTORICAL_DEBT
}

enum BillingAdjustmentType {
  DIRECTION_SCHOLARSHIP
  TEACHER_SCHOLARSHIP
  TEACHER_DISCOUNT
  LATE_FEE
  REVERSAL
  HISTORICAL_DISCOUNT
}

enum BillingCalculation {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
  CARD
  TRANSFER
}

enum PaymentStatus {
  CONFIRMED
  VOID
}

enum PaymentOrigin {
  CASH_DESK
  CONTROLFIT_IMPORT
}

/// Un cobro de cuotas se imputa a cuotas; uno OTHER no (clase suelta u otro concepto).
enum PaymentKind {
  CHARGES
  OTHER
}

enum OtherPaymentConcept {
  SINGLE_CLASS
  OTHER
  /// Legado: pasó al catálogo (`payment_concepts`). No se usa en cobros nuevos.
  APPAREL
  /// Legado: pasó al catálogo (`payment_concepts`). No se usa en cobros nuevos.
  GALA_SEAL
  /// Recargo por pagar con tarjeta (de la academia, fuera de la liquidación).
  CARD_SURCHARGE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  COLLECTION
  REVERSAL
  /// Devolución de saldo a favor: egreso del turno de quien devuelve.
  REFUND
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  IN_PERSON
}

enum LeadStatus {
  INQUIRY
  INTERESTED
  TRIAL
  ENROLLED
  NOT_CONVERTED
}

model Lead {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(180)
  phone               String?          @db.VarChar(80)
  normalizedPhone     String?          @map("normalized_phone") @db.VarChar(50)
  email               String?          @db.VarChar(254)
  normalizedEmail     String?          @map("normalized_email") @db.VarChar(254)
  instagram           String?          @db.VarChar(100)
  normalizedInstagram String?          @map("normalized_instagram") @db.VarChar(100)
  source              LeadSource
  status              LeadStatus       @default(INQUIRY)
  notes               String?
  nextFollowUpAt      DateTime?        @map("next_follow_up_at") @db.Timestamptz(3)
  lastContactAt       DateTime?        @map("last_contact_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  trialClasses        LeadTrialClass[]

  @@index([name])
  @@index([status, updatedAt(sort: Desc)])
  @@index([source, updatedAt(sort: Desc)])
  @@index([nextFollowUpAt])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([normalizedInstagram])
  @@map("leads")
}

/// Clase de prueba gratis de un potencial alumno: una sola vez por clase, sin deuda ni inscripción.
model LeadTrialClass {
  id              String       @id @default(uuid()) @db.Uuid
  leadId          String       @map("lead_id") @db.Uuid
  classId         String       @map("class_id") @db.Uuid
  trialDate       DateTime     @map("trial_date") @db.Date
  notes           String?      @db.VarChar(500)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  academicClass   AcademyClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy       AdminUser    @relation("LeadTrialClassCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([leadId, classId])
  @@index([classId, trialDate])
  @@map("lead_trial_classes")
}

model Student {
  id             String          @id @default(uuid()) @db.Uuid
  dni            String          @unique @db.VarChar(32)
  firstName      String          @map("first_name") @db.VarChar(100)
  lastName       String          @map("last_name") @db.VarChar(100)
  birthDate      DateTime?       @map("birth_date") @db.Date
  phone          String?         @db.VarChar(50)
  email          String?         @db.VarChar(254)
  address        String?
  joinedAt       DateTime        @default(now()) @map("joined_at") @db.Date
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollments    Enrollment[]
  monthlyCharges MonthlyCharge[]
  payments       Payment[]

  @@index([lastName, firstName])
  @@map("students")
}

model Teacher {
  id                String                       @id @default(uuid()) @db.Uuid
  dni               String                       @unique @db.VarChar(32)
  firstName         String                       @map("first_name") @db.VarChar(100)
  lastName          String                       @map("last_name") @db.VarChar(100)
  phone             String?                      @db.VarChar(50)
  email             String?                      @db.VarChar(254)
  address           String?
  status            RecordStatus                 @default(ACTIVE)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes           AcademyClass[]
  additionalClasses ClassAdditionalTeacher[]
  settlementShares  ClassSettlementShare[]
  billingConditions EnrollmentBillingCondition[]
  chargeAdjustments MonthlyChargeAdjustment[]
  payments          Payment[]

  @@index([lastName, firstName])
  @@map("teachers")
}

model DanceType {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(100)
  normalizedName String         @unique @map("normalized_name") @db.VarChar(100)
  description    String?
  status         RecordStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  classes        AcademyClass[]

  @@index([name])
  @@map("dance_types")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(120)
  address   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  rooms     Room[]

  @@index([name])
  @@map("branches")
}

model Room {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(120)
  capacity  Int
  branchId  String          @map("branch_id") @db.Uuid
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch          @relation(fields: [branchId], references: [id])
  schedules ClassSchedule[]

  @@index([branchId, status])
  @@index([name])
  @@map("rooms")
}

model AcademyClass {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(150)
  danceTypeId        String                   @map("dance_type_id") @db.Uuid
  teacherId          String                   @map("teacher_id") @db.Uuid
  level              String?                  @db.VarChar(100)
  capacity           Int
  status             RecordStatus             @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  danceType          DanceType                @relation(fields: [danceTypeId], references: [id])
  teacher            Teacher                  @relation(fields: [teacherId], references: [id])
  additionalTeachers ClassAdditionalTeacher[]
  settlementPlans    ClassSettlementPlan[]
  schedules          ClassSchedule[]
  enrollments        Enrollment[]
  tariffs            Tariff[]
  payments           Payment[]
  leadTrialClasses   LeadTrialClass[]

  @@index([danceTypeId, status])
  @@index([teacherId, status])
  @@index([name])
  @@map("classes")
}

/// Profesores que dictan la clase además del responsable (`AcademyClass.teacherId`).
model ClassAdditionalTeacher {
  classId   String       @map("class_id") @db.Uuid
  teacherId String       @map("teacher_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  class     AcademyClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher      @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
  @@index([teacherId])
  @@map("class_additional_teachers")
}

/// Reparto de lo cobrado de una clase entre sus profesores, vigente desde un mes (decisión 227).
/// Lo que no se reparte queda para la academia (Dirección).
model ClassSettlementPlan {
  id              String                 @id @default(uuid()) @db.Uuid
  classId         String                 @map("class_id") @db.Uuid
  /// Primer día del mes desde el que rige.
  validFrom       DateTime               @map("valid_from") @db.Date
  reason          String?                @db.VarChar(500)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  class           AcademyClass           @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy       AdminUser              @relation("SettlementPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  shares          ClassSettlementShare[]

  @@unique([classId, validFrom])
  @@map("class_settlement_plans")
}

model ClassSettlementShare {
  planId     String              @map("plan_id") @db.Uuid
  teacherId  String              @map("teacher_id") @db.Uuid
  percentage Decimal             @db.Decimal(5, 2)
  plan       ClassSettlementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  teacher    Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([planId, teacherId])
  @@index([teacherId])
  @@map("class_settlement_shares")
}

/// Liquidación de un mes cerrada por Dirección: queda fija aunque después cambien los pagos.
model SettlementClosing {
  id             String    @id @default(uuid()) @db.Uuid
  /// Primer día del mes liquidado.
  period         DateTime  @unique @db.Date
  snapshot       Json
  note           String?   @db.VarChar(500)
  closedByUserId String    @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime  @default(now()) @map("closed_at") @db.Timestamptz(3)
  closedBy       AdminUser @relation("SettlementClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@map("settlement_closings")
}

enum EnrollmentEndReason {
  NO_LONGER_ATTENDING
  SCHEDULE_CHANGE
  DISCIPLINE_CHANGE
  PERSONAL_REASONS
  NON_PAYMENT
  OTHER
}

model Enrollment {
  id                String                       @id @default(uuid()) @db.Uuid
  studentId         String                       @map("student_id") @db.Uuid
  classId           String                       @map("class_id") @db.Uuid
  startDate         DateTime                     @map("start_date") @db.Date
  endDate           DateTime?                    @map("end_date") @db.Date
  endReason         EnrollmentEndReason?         @map("end_reason")
  endNote           String?                      @map("end_note") @db.VarChar(500)
  /// Modalidad: tarifa que paga el alumno. Null = la única tarifa vigente de la clase.
  tariffId          String?                      @map("tariff_id") @db.Uuid
  /// Día de pago acordado (1 a 31; en meses más cortos, el último día del mes).
  paymentDueDay     Int                          @default(10) @map("payment_due_day")
  status            EnrollmentStatus             @default(ACTIVE)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  student           Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class             AcademyClass                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  tariff            Tariff?                      @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  monthlyCharges    MonthlyCharge[]
  attendances       StudentAttendance[]
  billingConditions EnrollmentBillingCondition[]

  @@index([studentId, status])
  @@index([classId, status])
  @@index([tariffId])
  @@map("enrollments")
}

model Tariff {
  id        String       @id @default(uuid()) @db.Uuid
  classId   String       @map("class_id") @db.Uuid
  name      String       @db.VarChar(120)
  amount    Decimal      @db.Decimal(12, 2)
  validFrom DateTime     @map("valid_from") @db.Date
  validTo   DateTime?    @map("valid_to") @db.Date
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  class          AcademyClass    @relation(fields: [classId], references: [id], onDelete: Restrict)
  monthlyCharges MonthlyCharge[]
  enrollments    Enrollment[]

  @@index([classId, validFrom, validTo])
  @@index([status, validFrom, validTo])
  @@index([name])
  @@map("tariffs")
}

model MonthlyCharge {
  id             String                    @id @default(uuid()) @db.Uuid
  studentId      String                    @map("student_id") @db.Uuid
  enrollmentId   String                    @map("enrollment_id") @db.Uuid
  tariffId       String?                   @map("tariff_id") @db.Uuid
  kind           MonthlyChargeKind         @default(MONTHLY)
  /// Detalle de la deuda histórica (obligatorio en HISTORICAL_DEBT, null en MONTHLY).
  description    String?                   @db.VarChar(200)
  period         DateTime                  @db.Date
  baseAmount     Decimal                   @map("base_amount") @db.Decimal(12, 2)
  discountAmount Decimal                   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount    Decimal                   @map("final_amount") @db.Decimal(12, 2)
  dueDate        DateTime                  @map("due_date") @db.Date
  status         MonthlyChargeStatus       @default(PENDING)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  student        Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment     Enrollment                @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  tariff         Tariff?                   @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  adjustments    MonthlyChargeAdjustment[]

  // Única por inscripción y mes solo para MONTHLY: índice parcial
  // "monthly_charges_enrollment_id_period_key" creado en la migración (Prisma no lo expresa).
  @@index([studentId, period, status])
  @@index([enrollmentId, period, status])
  @@index([period, status])
  @@index([tariffId])
  @@map("monthly_charges")
}

model EnrollmentBillingCondition {
  id                 String                       @id @default(uuid()) @db.Uuid
  enrollmentId       String                       @map("enrollment_id") @db.Uuid
  type               BillingAdjustmentType
  calculation        BillingCalculation
  configuredValue    Decimal                      @map("configured_value") @db.Decimal(12, 2)
  effectiveFrom      DateTime                     @map("effective_from") @db.Date
  effectiveUntil     DateTime?                    @map("effective_until") @db.Date
  teacherId          String?                      @map("teacher_id") @db.Uuid
  authorizedByUserId String?                      @map("authorized_by_user_id") @db.Uuid
  createdByUserId    String                       @map("created_by_user_id") @db.Uuid
  endedByUserId      String?                      @map("ended_by_user_id") @db.Uuid
  endedAt            DateTime?                    @map("ended_at") @db.Timestamptz(3)
  reason             String                       @db.VarChar(500)
  endReason          String?                      @map("end_reason") @db.VarChar(500)
  renewedFromId      String?                      @map("renewed_from_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment         Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  teacher            Teacher?                     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  authorizedBy       AdminUser?                   @relation("BillingConditionAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)
  createdBy          AdminUser                    @relation("BillingConditionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  endedBy            AdminUser?                   @relation("BillingConditionEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)
  renewedFrom        EnrollmentBillingCondition?  @relation("BillingConditionRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals           EnrollmentBillingCondition[] @relation("BillingConditionRenewal")
  adjustments        MonthlyChargeAdjustment[]

  @@index([enrollmentId, effectiveFrom, effectiveUntil])
  @@index([teacherId])
  @@map("enrollment_billing_conditions")
}

model MonthlyChargeAdjustment {
  id                  String                      @id @default(uuid()) @db.Uuid
  monthlyChargeId     String                      @map("monthly_charge_id") @db.Uuid
  sourceConditionId   String?                     @map("source_condition_id") @db.Uuid
  type                BillingAdjustmentType
  calculation         BillingCalculation?
  configuredValue     Decimal?                    @map("configured_value") @db.Decimal(12, 2)
  effectiveAmount     Decimal                     @map("effective_amount") @db.Decimal(12, 2)
  studentAmountDelta  Decimal                     @map("student_amount_delta") @db.Decimal(12, 2)
  settlementBaseDelta Decimal                     @map("settlement_base_delta") @db.Decimal(12, 2)
  teacherId           String?                     @map("teacher_id") @db.Uuid
  authorizedByUserId  String?                     @map("authorized_by_user_id") @db.Uuid
  createdByUserId     String?                     @map("created_by_user_id") @db.Uuid
  reason              String?                     @db.VarChar(500)
  reversalOfId        String?                     @unique @map("reversal_of_id") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  monthlyCharge       MonthlyCharge               @relation(fields: [monthlyChargeId], references: [id], onDelete: Restrict)
  sourceCondition     EnrollmentBillingCondition? @relation(fields: [sourceConditionId], references: [id], onDelete: Restrict)
  teacher             Teacher?                    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  authorizedBy        AdminUser?                  @relation("ChargeAdjustmentAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)
  createdBy           AdminUser?                  @relation("ChargeAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversalOf          MonthlyChargeAdjustment?    @relation("ChargeAdjustmentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal            MonthlyChargeAdjustment?    @relation("ChargeAdjustmentReversal")

  @@unique([monthlyChargeId, sourceConditionId])
  @@index([monthlyChargeId, createdAt])
  @@index([teacherId])
  @@map("monthly_charge_adjustments")
}

model Payment {
  id              String                @id @default(uuid()) @db.Uuid
  /// Null solo en la clase suelta de un alumno eventual (sin ficha): ver walkIn*.
  studentId       String?               @map("student_id") @db.Uuid
  /// Alumno eventual: nombre y, si los dio, teléfono y DNI normalizado.
  walkInName      String?               @map("walk_in_name") @db.VarChar(160)
  walkInPhone     String?               @map("walk_in_phone") @db.VarChar(80)
  walkInDni       String?               @map("walk_in_dni") @db.VarChar(20)
  amount          Decimal               @db.Decimal(12, 2)
  status          PaymentStatus         @default(CONFIRMED)
  origin          PaymentOrigin         @default(CASH_DESK)
  legacyReference String?               @unique @map("legacy_reference") @db.VarChar(80)
  kind            PaymentKind           @default(CHARGES)
  concept         OtherPaymentConcept?
  conceptDetail   String?               @map("concept_detail") @db.VarChar(200)
  /// Concepto del catálogo (solo con `concept = OTHER`).
  conceptId       String?               @map("concept_id") @db.Uuid
  classId         String?               @map("class_id") @db.Uuid
  /// Profesor que dictó la clase suelta (foto al cobrar, para liquidaciones).
  teacherId       String?               @map("teacher_id") @db.Uuid
  paidAt          DateTime              @default(now()) @map("paid_at") @db.Timestamptz(3)
  /// Pago anulado que este reemplaza al corregirlo (medio, importe o fecha).
  correctionOfId  String?               @unique @map("correction_of_id") @db.Uuid
  /// Recargo por tarjeta: el cobro de cuotas con el que se cobró (se anula con él).
  surchargeOfId   String?               @unique @map("surcharge_of_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  voidedAt        DateTime?             @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?               @map("voided_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  student         Student?              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy       AdminUser             @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy        AdminUser?            @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  academicClass   AcademyClass?         @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher         Teacher?              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  correctionOf    Payment?              @relation("PaymentCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  correctedBy     Payment?              @relation("PaymentCorrection")
  surchargeOf     Payment?              @relation("CardSurcharge", fields: [surchargeOfId], references: [id], onDelete: Restrict)
  cardSurcharge   Payment?              @relation("CardSurcharge")
  catalogConcept  PaymentConcept?       @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]
  reallocations   PaymentReallocation[]
  refunds         PaymentRefund[]
  tenders         PaymentTender[]
  cashMovements   CashMovement[]

  @@index([studentId, paidAt])
  @@index([status, paidAt])
  @@index([kind, paidAt])
  @@index([teacherId, paidAt])
  @@map("payments")
}

/// Devolución de saldo a favor de un pago de cuotas (Dirección). Si es efectivo de la caja, egreso
/// REFUND en el turno de quien devuelve; si no (cash_shift_id null), queda fuera de la caja.
model PaymentRefund {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  cashShiftId     String?       @map("cash_shift_id") @db.Uuid
  reason          String        @db.VarChar(500)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cashShift       CashShift?    @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  createdBy       AdminUser     @relation("PaymentRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cashMovement    CashMovement?

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_refunds")
}

model PaymentTender {
  id            String         @id @default(uuid()) @db.Uuid
  paymentId     String         @map("payment_id") @db.Uuid
  method        PaymentMethod
  amount        Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cashMovements CashMovement[]

  @@unique([paymentId, method])
  @@index([method, createdAt])
  @@map("payment_tenders")
}

model CashShift {
  id             String                         @id @default(uuid()) @db.Uuid
  userId         String                         @map("user_id") @db.Uuid
  status         CashShiftStatus                @default(OPEN)
  openedAt       DateTime                       @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt       DateTime?                      @map("closed_at") @db.Timestamptz(3)
  closedByUserId String?                        @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           AdminUser                      @relation("CashShiftUser", fields: [userId], references: [id], onDelete: Restrict)
  closedBy       AdminUser?                     @relation("CashShiftClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements      CashMovement[]
  closingLines   CashShiftClosingLine[]
  corrections    CashReconciliationCorrection[]
  refunds        PaymentRefund[]

  @@index([userId, openedAt(sort: Desc)])
  @@index([status, openedAt(sort: Desc)])
  @@map("cash_shifts")
}

model CashMovement {
  id                    String           @id @default(uuid()) @db.Uuid
  cashShiftId           String           @map("cash_shift_id") @db.Uuid
  type                  CashMovementType
  method                PaymentMethod
  amount                Decimal          @db.Decimal(12, 2)
  sourcePaymentId       String           @map("source_payment_id") @db.Uuid
  /// Null en una devolución (REFUND): apunta a la devolución, no a un medio del pago.
  sourcePaymentTenderId String?          @map("source_payment_tender_id") @db.Uuid
  refundId              String?          @unique @map("refund_id") @db.Uuid
  reversalOfId          String?          @unique @map("reversal_of_id") @db.Uuid
  actorUserId           String           @map("actor_user_id") @db.Uuid
  reason                String?          @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  cashShift             CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  sourcePayment         Payment          @relation(fields: [sourcePaymentId], references: [id], onDelete: Restrict)
  sourcePaymentTender   PaymentTender?   @relation(fields: [sourcePaymentTenderId], references: [id], onDelete: Restrict)
  refund                PaymentRefund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  reversalOf            CashMovement?    @relation("CashMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal              CashMovement?    @relation("CashMovementReversal")
  actor                 AdminUser        @relation("CashMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([cashShiftId, createdAt])
  @@index([sourcePaymentId])
  @@index([sourcePaymentTenderId])
  @@map("cash_movements")
}

model CashShiftClosingLine {
  id               String        @id @default(uuid()) @db.Uuid
  cashShiftId      String        @map("cash_shift_id") @db.Uuid
  method           PaymentMethod
  expectedAmount   Decimal       @map("expected_amount") @db.Decimal(12, 2)
  declaredAmount   Decimal       @map("declared_amount") @db.Decimal(12, 2)
  differenceAmount Decimal       @map("difference_amount") @db.Decimal(12, 2)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  cashShift        CashShift     @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)

  @@unique([cashShiftId, method])
  @@map("cash_shift_closing_lines")
}

model CashReconciliationCorrection {
  id                      String        @id @default(uuid()) @db.Uuid
  cashShiftId             String        @map("cash_shift_id") @db.Uuid
  method                  PaymentMethod
  amountDelta             Decimal       @map("amount_delta") @db.Decimal(12, 2)
  originalDeclaredAmount  Decimal       @map("original_declared_amount") @db.Decimal(12, 2)
  correctedDeclaredAmount Decimal       @map("corrected_declared_amount") @db.Decimal(12, 2)
  reason                  String        @db.VarChar(500)
  createdByUserId         String        @map("created_by_user_id") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  cashShift               CashShift     @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  createdBy               AdminUser     @relation("CashCorrectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([cashShiftId, method, createdAt])
  @@map("cash_reconciliation_corrections")
}

model PaymentAllocation {
  id              String               @id @default(uuid()) @db.Uuid
  paymentId       String               @map("payment_id") @db.Uuid
  monthlyChargeId String               @map("monthly_charge_id") @db.Uuid
  /// Negativo solo en una reimputación: resta lo que se saca de una cuota.
  amount          Decimal              @db.Decimal(12, 2)
  /// Reimputación que agregó esta fila; null en la imputación original del cobro.
  /// (Índice único parcial en SQL: una imputación original por pago y cuota.)
  reallocationId  String?              @map("reallocation_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  payment         Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  monthlyCharge   MonthlyCharge        @relation(fields: [monthlyChargeId], references: [id], onDelete: Restrict)
  reallocation    PaymentReallocation? @relation(fields: [reallocationId], references: [id], onDelete: Restrict)

  @@unique([reallocationId, monthlyChargeId])
  @@index([paymentId])
  @@index([monthlyChargeId])
  @@map("payment_allocations")
}

/// Concepto de ingreso de los otros cobros (indumentaria, inscripciones, talleres…). Lo amplían
/// Administración y Dirección; se desactiva, no se borra.
model PaymentConcept {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(80)
  normalizedName String       @unique @map("normalized_name") @db.VarChar(80)
  /// Exige contar qué se cobró (por ejemplo, "Otros").
  requiresDetail Boolean      @default(false) @map("requires_detail")
  status         RecordStatus @default(ACTIVE)
  sortOrder      Int          @default(100) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments       Payment[]

  @@map("payment_concepts")
}

/// Entrega del efectivo recaudado a Dirección: no es un gasto ni un movimiento de turno.
model CashHandover {
  id              String     @id @default(uuid()) @db.Uuid
  /// Período de recaudación que cubre (días de Buenos Aires).
  fromDate        DateTime   @map("from_date") @db.Date
  toDate          DateTime   @map("to_date") @db.Date
  amount          Decimal    @db.Decimal(12, 2)
  /// Efectivo cobrado en el período al registrar la entrega.
  collectedAmount Decimal    @map("collected_amount") @db.Decimal(12, 2)
  receivedBy      String     @map("received_by") @db.VarChar(120)
  note            String?    @db.VarChar(500)
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime?  @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?    @map("voided_by_user_id") @db.Uuid
  voidReason      String?    @map("void_reason") @db.VarChar(500)
  createdBy       AdminUser  @relation("CashHandoverCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy        AdminUser? @relation("CashHandoverVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([toDate])
  @@map("cash_handovers")
}

/// Corrección de las cuotas a las que se imputó un pago: no cambia el pago ni la caja; agrega
/// filas de imputación (negativas en las cuotas que pierden, positivas en las que ganan).
model PaymentReallocation {
  id              String              @id @default(uuid()) @db.Uuid
  paymentId       String              @map("payment_id") @db.Uuid
  reason          String              @db.VarChar(500)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  payment         Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy       AdminUser           @relation("PaymentReallocationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@index([paymentId])
  @@map("payment_reallocations")
}

model ClassSchedule {
  id          String              @id @default(uuid()) @db.Uuid
  classId     String              @map("class_id") @db.Uuid
  dayOfWeek   DayOfWeek           @map("day_of_week")
  startTime   DateTime            @map("start_time") @db.Time(0)
  endTime     DateTime            @map("end_time") @db.Time(0)
  roomId      String              @map("room_id") @db.Uuid
  status      RecordStatus        @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  class       AcademyClass        @relation(fields: [classId], references: [id])
  room        Room                @relation(fields: [roomId], references: [id])
  attendances StudentAttendance[]

  @@index([classId, status])
  @@index([roomId, dayOfWeek, status, startTime, endTime])
  @@map("class_schedules")
}

model StudentAttendance {
  id             String           @id @default(uuid()) @db.Uuid
  enrollmentId   String           @map("enrollment_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  /// Horario de la clase al que corresponde. Null = asistencia fuera de horario (otro día).
  scheduleId     String?          @map("schedule_id") @db.Uuid
  status         AttendanceStatus
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  schedule       ClassSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  // La migración crea este índice con NULLS NOT DISTINCT: una sola asistencia fuera de horario por día.
  @@unique([enrollmentId, attendanceDate, scheduleId], map: "student_attendances_enrollment_date_schedule_key")
  @@index([attendanceDate])
  @@index([scheduleId, attendanceDate])
  @@map("student_attendances")
}

model AdminUser {
  id                          String                         @id @default(uuid()) @db.Uuid
  username                    String                         @unique @db.VarChar(100)
  passwordHash                String                         @map("password_hash")
  role                        AdminRole                      @default(RECEPTION)
  status                      RecordStatus                   @default(ACTIVE)
  createdAt                   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                    AdminSession[]
  paymentsCreated             Payment[]                      @relation("PaymentCreatedBy")
  paymentsVoided              Payment[]                      @relation("PaymentVoidedBy")
  auditLogs                   AuditLog[]
  billingConditionsAuthorized EnrollmentBillingCondition[]   @relation("BillingConditionAuthorizedBy")
  billingConditionsCreated    EnrollmentBillingCondition[]   @relation("BillingConditionCreatedBy")
  billingConditionsEnded      EnrollmentBillingCondition[]   @relation("BillingConditionEndedBy")
  chargeAdjustmentsAuthorized MonthlyChargeAdjustment[]      @relation("ChargeAdjustmentAuthorizedBy")
  chargeAdjustmentsCreated    MonthlyChargeAdjustment[]      @relation("ChargeAdjustmentCreatedBy")
  cashShifts                  CashShift[]                    @relation("CashShiftUser")
  cashShiftsClosed            CashShift[]                    @relation("CashShiftClosedBy")
  cashMovements               CashMovement[]                 @relation("CashMovementActor")
  cashCorrections             CashReconciliationCorrection[] @relation("CashCorrectionCreatedBy")
  settlementPlansCreated      ClassSettlementPlan[]          @relation("SettlementPlanCreatedBy")
  settlementsClosed           SettlementClosing[]            @relation("SettlementClosedBy")
  paymentReallocations        PaymentReallocation[]          @relation("PaymentReallocationCreatedBy")
  cashHandoversCreated        CashHandover[]                 @relation("CashHandoverCreatedBy")
  cashHandoversVoided         CashHandover[]                 @relation("CashHandoverVoidedBy")
  leadTrialClassesCreated     LeadTrialClass[]               @relation("LeadTrialClassCreatedBy")
  paymentRefundsCreated       PaymentRefund[]                @relation("PaymentRefundCreatedBy")

  @@map("admin_users")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String    @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(50)
  entityType  String    @map("entity_type") @db.VarChar(80)
  entityId    String?   @map("entity_id") @db.Uuid
  reason      String?   @db.VarChar(500)
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       AdminUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
