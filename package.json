{
  "name": "gestion-academia",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env packages/database/prisma/seed.ts",
    "render:build:api": "npm ci --include=dev && npm run db:generate && npm run build --workspace=@academy/api",
    "render:start:api": "npm run db:deploy && npm run start --workspace=@academy/api",
    "render:build:web": "npm ci --include=dev && npm run build --workspace=@academy/admin-web",
    "render:start:web": "npm run start --workspace=@academy/admin-web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "tsx": "^4.23.12"
  }
}
