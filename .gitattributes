# Normaliza saltos de línea: LF en el repositorio y en la copia de trabajo, en cualquier sistema.
* text=auto eol=lf

# Scripts de Windows conservan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
