## Base de datos (Prisma)
DATABASE_URL="postgresql://neondb_owner:xxxxxx/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:xxxxxx/neondb?sslmode=require&channel_binding=require"

## Aplicación local
NODE_ENV="development"
API_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
BUSINESS_TIMEZONE="America/Buenos_Aires"
AUTH_SESSION_HOURS="12"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"
ADMIN_ORIGINS="http://localhost:3000"
# ADMIN_WEB_URL="http://localhost:3000"
# PORT es provisto por la plataforma de hosting; no definirlo localmente.

## Seed local (opcional)
DEV_SEED_PASSWORD="CHANGE_ME_BEFORE_SEEDING"
# CI lo proveen los runners; no definirlo en desarrollo local.

## Scripts administrativos e importaciones (opcionales)
API_BASE_URL="http://localhost:3001/api/v1"
API_URL="http://localhost:3001/api/v1"
IMPORT_ADMIN_USERNAME="CHANGE_ME"
IMPORT_ADMIN_PASSWORD="CHANGE_ME"
# Importación histórica de cobros de ControlFit: usuario responsable de los pagos importados.
CONTROLFIT_IMPORT_USERNAME="CHANGE_ME"
# Solo al aplicar: debe coincidir con el nombre de la base de DATABASE_URL.
# CONTROLFIT_IMPORT_CONFIRM="academy"

## Seed de staging: mantener comentado salvo ejecución manual y controlada.
# ALLOW_STAGING_SEED="true"
# STAGING_SEED_TARGET="academy_staging"
# STAGING_SEED_CONFIRM="SEED_ACADEMY_STAGING"
# STAGING_SEED_PASSWORD="CHANGE_ME_BEFORE_STAGING_SEED"
